<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
	bootstrap="../tests/bootstrap.php"
	beStrictAboutChangesToGlobalState="true"
	beStrictAboutOutputDuringTests="true"
	failOnEmptyTestSuite="true"
	failOnWarning="true"
	failOnNotice="true"
	failOnDeprecation="false"
	failOnRisky="true"
	failOnIncomplete="true"
	failOnSkipped="true"
	failOnPhpunitWarning="true"
	failOnPhpunitNotice="true"
	failOnPhpunitDeprecation="false"
	displayDetailsOnAllIssues="true"
	recordTestRunHistory="false"
	colors="false">
	<testsuites>
		<testsuite name="architecture">
			<directory>../tests/Suites/Architecture</directory>
		</testsuite>
		<testsuite name="integration">
			<directory>../tests/Suites/Integration</directory>
		</testsuite>
		<testsuite name="unit">
			<directory>../tests/Suites/Unit</directory>
		</testsuite>
	</testsuites>
	<source
		restrictNotices="false"
		restrictWarnings="false">
		<include>
			<directory>../src</directory>
		</include>
	</source>
</phpunit>
